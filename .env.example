# Copy to .env and adjust. Both docker-compose files and `pnpm dev` read these.
# On the VPS, paste the production values into Dokploy's Environment tab.
#
# Build time: NEXT_PUBLIC_SERVER_URL, R2_PUBLIC_URL and the UMAMI_* values are
# baked into the production image.
# After changing one of them, redeploy; a restart keeps the old values.

# --- Postgres (used by the compose `db` service) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# Host port the compose `db` service publishes (keep DATABASE_URL in sync).
POSTGRES_HOST_PORT=5432

# --- Database connection ---
# For the app running on the HOST (pnpm dev), connect to localhost.
# Inside docker compose the app overrides this to reach the `db` service.
# In production, leave it for the prod compose to build from the vars above,
# or point it at a managed Postgres.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
# Remote databases `pnpm db:push <target>` can overwrite with the local data
# (<TARGET>_DATABASE_URL). Local only, never set these on a server. A DB behind
# an SSH tunnel works too: point it at localhost:<tunnel port>.
PROD_DATABASE_URL=

# --- Payload ---
# Generate a strong value in production: `openssl rand -base64 32`
PAYLOAD_SECRET=change-me-in-production

# --- Public site URL (SEO, CORS, absolute links) ---
# Production: the real origin with its protocol, e.g. https://example.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- SEO ---
# Production builds are indexable; `pnpm dev` serves noindex. Verify the
# domain in Search Console and Bing Webmaster Tools with DNS TXT records.
# IndexNow (Bing, Yandex, …; Bing also feeds ChatGPT Search and Copilot):
# pings search engines the moment a page/post is published or removed. Set in
# production only. Any 8–128 char [a-zA-Z0-9-] string, e.g. `openssl rand -hex 16`.
INDEXNOW_KEY=

# --- Live preview ---
# Shared secret guarding the draft-mode preview route.
PREVIEW_SECRET=change-me-preview-secret

# --- Media storage: Cloudflare R2 (optional) ---
# Leave these blank in local dev to store uploads on disk (public/media).
# Set all four to ship Media uploads to an R2 bucket (S3-compatible).
# Create the bucket and an R2 API token in the Cloudflare dashboard:
#   R2 > Overview > Create bucket, then Manage R2 API Tokens > Create.
R2_BUCKET=
# Endpoint uses your Cloudflare account id: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Folder (key prefix) inside the bucket for Media uploads, so local and prod
# uploads never mix. Defaults to website/cms/local when unset.
#   local: website/cms/local   prod: website/cms/prod
R2_MEDIA_PREFIX=website/cms/local
# Optional: serve files from a public R2 domain (r2.dev or a custom domain).
# When set, image URLs point here directly instead of proxying through Payload.
# e.g. https://pub-xxxxxxxx.r2.dev  or  https://cdn.example.com
R2_PUBLIC_URL=

# --- Analytics: Umami Cloud (optional, cookieless) ---
# Set UMAMI_ENABLED=true on production only. It never tracks under `pnpm dev`
# (NODE_ENV must be production) and stays off while UMAMI_WEBSITE_ID is blank.
# Events tracked: src/lib/integrations/umami/README.md
UMAMI_ENABLED=
# cloud.umami.is > Settings > Websites > (site) > Edit: the Website ID.
UMAMI_WEBSITE_ID=
# Optional: comma-separated hostnames allowed to report, e.g.
# example.com,www.example.com. A copy of the site on any other host sends nothing.
UMAMI_DOMAINS=
